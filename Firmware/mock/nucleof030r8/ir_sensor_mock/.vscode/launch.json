{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32F030 (ST-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "CMake: Build Debug",
      "servertype": "stlink",
      "serverpath": "C:/ST/STM32CubeCLT_1.19.0/STLink-gdb-server/bin/ST-LINK_gdbserver.exe",
      "gdbPath": "C:/ST/STM32CubeCLT_1.19.0/GNU-tools-for-STM32/bin/arm-none-eabi-gdb.exe",
      "executable": "${workspaceFolder}/build/Debug/ir_sensor_mock.elf",
      "device": "STM32F030x8",
      "interface": "swd",
      "runToEntryPoint": "main"
    }
  ]
}

